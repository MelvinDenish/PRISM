# PRISM Client Environment Variables
# Copy this to .env.local for local development

# API URL — backend server base URL (with /api suffix)
VITE_API_URL=http://localhost:5000/api

# Socket URL — backend server URL for WebSocket connections
VITE_SOCKET_URL=http://localhost:5000

# Product analytics (PostHog) — OPTIONAL. Leave unset and analytics no-ops.
# VITE_POSTHOG_KEY is the *public* project API key (safe in the client bundle).
# Get it from PostHog -> Project Settings -> Project API Key.
# VITE_POSTHOG_HOST: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU).
# VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
