# ── PRISM GD AI Panelist (voice-agent) ─────────────────────────────────────────
# Copy to .env and fill in. Everything is provider-agnostic / OpenAI-compatible so
# this runs on ANY host and the GPU TTS can live on any serverless-GPU provider.

# LiveKit (REQUIRED) — the SAME self-hosted LiveKit the PRISM app already uses.
# The worker mints its own join tokens from these, so no PRISM server change is needed.
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Brain (LLM) — Groq by default (free/cheap). Swap LLM_BASE_URL for any OpenAI-
# compatible provider (vLLM, Together, OpenAI, a self-hosted endpoint, …).
GROQ_API_KEY=your_groq_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Ears (STT) — Groq-hosted Whisper by default (same key, no GPU).
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo

# Voice (TTS) — pick ONE:
#  (a) ZERO-GPU on-ramp: Groq-hosted Orpheus on the same GROQ_API_KEY.
#      ⚠️ ONE-TIME: your Groq org admin must accept the Orpheus model terms at
#      https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
#      (otherwise Groq returns 400 model_terms_required). playai-tts is decommissioned.
TTS_PROVIDER=groq
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=troy
#  (b) FREE-FOREVER at scale, NO terms gate: your own streaming Orpheus on serverless
#      GPU (Modal / RunPod), exposed as an OpenAI-compatible /v1/audio/speech endpoint:
# TTS_PROVIDER=openai
# TTS_BASE_URL=https://your-orpheus-endpoint/v1
# TTS_API_KEY=your_endpoint_key
# TTS_MODEL=orpheus
# TTS_VOICE=tara

# LOG_LEVEL=INFO
