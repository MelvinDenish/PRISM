# PRISM backend — PRODUCTION env for the AWS deploy (Part A).
# On the box:  cp deploy/server.env.production.example server/.env  then fill in.
# This is the deploy-focused subset; the full annotated list is server/.env.example.

# ── REQUIRED ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
# MongoDB Atlas M0 SRV string (Database → Connect → Drivers).
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/prism?retryWrites=true&w=majority
# Long random secret (e.g. `openssl rand -hex 32`).
JWT_SECRET=

# ── PUBLIC URLs / CORS ───────────────────────────────────────────────────────
# CloudFront frontend origin(s), comma-separated. MUST match where the SPA is served
# (Socket.IO + CORS reject anything else). No trailing slash.
CLIENT_URL=https://dXXXXXXXX.cloudfront.net
# This backend's public HTTPS origin (the DuckDNS subdomain fronted by Caddy).
SERVER_PUBLIC_URL=https://prism-api.duckdns.org

# ── CODE EXECUTION (self-hosted Judge0 in the compose stack) ─────────────────
JUDGE0_API_URL=http://judge0-server:2358

# ── FILE STORAGE (S3 so uploads survive redeploys) ───────────────────────────
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CloudFront CDN base for served files:
S3_PUBLIC_BASE_URL=

# ── LIVE VIDEO (LiveKit Cloud free tier) ─────────────────────────────────────
# Project → Settings. WS URL is wss:// for LiveKit Cloud.
LIVEKIT_WS_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── AI FEATURES (optional; graceful-degrade when blank) ──────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=

# ── EMAIL (optional; Gmail App Password) ─────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
