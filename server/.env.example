# PRISM Server Environment Variables
# Copy this file to `.env` and fill in real values.
# The server validates these at boot (see config/env.js) and refuses to start
# if a REQUIRED variable is missing. Variables marked "feature" disable a
# capability when unset (the server warns but still starts).

# ── REQUIRED ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted). Server exits if missing.
MONGODB_URI=mongodb://localhost:27017/prism
# JWT signing secret — use a long random string (min 16 chars). Server exits if missing/weak.
JWT_SECRET=change-me-to-a-long-random-secret

# ── OPTIONAL (have defaults) ─────────────────────────────────────────────────
JWT_EXPIRE=7d
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed client origins (CORS + Socket.IO).
CLIENT_URL=http://localhost:5173
# Judge0 CE endpoint for sandboxed code execution (self-hosted in production).
JUDGE0_API_URL=http://localhost:2358
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── FEATURE-GATED (optional; capability disabled when unset) ─────────────────
# AI features (interview, interview game, group discussion, resume builder, summarize, learning paths)
GROQ_API_KEY=
# Resume ATS analysis (falls back to keyword matching when unset)
GEMINI_API_KEY=
# Email notifications via Gmail SMTP (use a Gmail App Password, not your login password)
EMAIL_USER=
EMAIL_PASS=
