# PRISM Server Environment Variables
# Copy this file to `.env` and fill in real values.
# The server validates these at boot (see config/env.js) and refuses to start
# if a REQUIRED variable is missing. Variables marked "feature" disable a
# capability when unset (the server warns but still starts).

# ── REQUIRED ────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted). Server exits if missing.
MONGODB_URI=mongodb://localhost:27017/prism
# JWT signing secret — use a long random string (min 16 chars). Server exits if missing/weak.
JWT_SECRET=change-me-to-a-long-random-secret

# ── OPTIONAL (have defaults) ─────────────────────────────────────────────────
JWT_EXPIRE=7d
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed client origins (CORS + Socket.IO).
CLIENT_URL=http://localhost:5173
# Judge0 CE endpoint for sandboxed code execution (self-hosted in production).
JUDGE0_API_URL=http://localhost:2358
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# ── FEATURE-GATED (optional; capability disabled when unset) ─────────────────
# AI features (interview, interview game, group discussion, resume builder, summarize, learning paths)
GROQ_API_KEY=
# Resume ATS analysis (falls back to keyword matching when unset)
GEMINI_API_KEY=
# Interview Game company question research (mentor + curated only when unset)
TAVILY_API_KEY=

# ── AGENTIC ASSISTANT ("PRISM Copilot") ──────────────────────────────────────
# Provider-agnostic, OpenAI-compatible LLM for the chat assistant's tool-calling.
# Provider + model are swappable: point LLM_BASE_URL at OpenRouter / Together /
# Fireworks / Groq / DeepInfra and set the model names to match.
#
# RECOMMENDED — OpenRouter (best free tool-capable models):
#   LLM_API_KEY=sk-or-...                       # your OpenRouter key (REQUIRED here;
#                                               #   a Groq key will NOT work on OpenRouter)
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_ORCHESTRATOR_MODEL=openai/gpt-oss-120b:free   # verified tool-calling on OpenRouter
#   # Other strong FREE tool-callers (confirm current slugs at
#   #   https://openrouter.ai/models?supported_parameters=tools&max_price=0 ):
#   #   qwen/qwen3-next-80b-a3b-instruct:free | nvidia/nemotron-3-super-120b-a12b:free |
#   #   openrouter/owl-alpha (1M ctx) | openrouter/free (auto-selects a free tool model)
#
# CRITICAL: the orchestrator MUST support tool/function calling (filter as above).
# Free models that don't will fail. The agent salvages occasional malformed tool
# calls, but a real tool-caller is required.
#
# Fallback — Groq (no extra key; reuses GROQ_API_KEY when LLM_API_KEY/BASE_URL unset):
#   leave these blank and the assistant runs on Groq llama-3.3-70b-versatile.
LLM_API_KEY=
LLM_BASE_URL=
LLM_ORCHESTRATOR_MODEL=llama-3.3-70b-versatile
LLM_GEN_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant

# ── Resume generator (AI-authored HTML resumes) — SWAPPABLE provider/models ──
# Separate per-stage models so the resume pipeline can use a stronger design model
# (or a self-hosted vLLM/Ollama endpoint) independent of the copilot. All fall back
# to LLM_* / GROQ_API_KEY, so leave them blank to use Groq out of the box.
# To self-host (private, free at scale) see docs/infra/self-host-resume-llm.md, then:
#   RESUME_LLM_BASE_URL=http://localhost:11434/v1   (Ollama)  or  http://localhost:8000/v1 (vLLM)
#   RESUME_LLM_API_KEY=ollama
#   RESUME_DESIGN_MODEL=qwen2.5-coder:32b
#   RESUME_CONTENT_MODEL=qwen2.5-coder:32b
RESUME_LLM_BASE_URL=
RESUME_LLM_API_KEY=
RESUME_DESIGN_MODEL=openai/gpt-oss-120b
RESUME_CONTENT_MODEL=llama-3.3-70b-versatile
#
# BEST FREE QUALITY: best-of-N + the curated catalog + few-shot exemplars do the heavy
# lifting; the vision critic stays on RELIABLE Groq (a critic 429 ships ungated generic).
# API keys AUTO-RESOLVE from HF_TOKEN / CEREBRAS_API_KEY / OPENROUTER_API_KEY / GROQ_API_KEY
# by base URL — no need to paste them into the RESUME_* vars.
# RESUME_DESIGN_MODELS (CSV) overrides RESUME_DESIGN_MODEL; first entry is the primary/repairer.
# Shared (both options):
#   RESUME_DESIGN_MAX_TOKENS=4500          # a one-page resume is ~2k tokens of output
#   RESUME_LLM_TIMEOUT_MS=120000           # big coders take 30–60s+ to author a full resume (default 30s is too short)
#   RESUME_GEN_DEADLINE_MS=180000          # wall-clock budget for the whole best-of-N + repair loop
#   RESUME_VISION_BASE_URL=https://api.groq.com/openai/v1
#   RESUME_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#
# OPTION A — Hugging Face (BEST CODERS: Kimi-K2.7-Code + Qwen3-Coder-Next). Top quality;
#   HF Inference has a limited monthly free credit, so best for moderate volume.
#   RESUME_LLM_BASE_URL=https://router.huggingface.co/v1
#   RESUME_DESIGN_MODELS=moonshotai/Kimi-K2.7-Code,Qwen/Qwen3-Coder-Next
#   RESUME_CONTENT_MODEL=Qwen/Qwen3-Coder-Next
#
# OPTION B — Cerebras (BEST FREE-AT-SCALE: GLM-4.7 + gpt-oss-120b). Very fast, 1M tokens/day,
#   30 RPM, not rate-limited like OpenRouter free pools — best when many students generate.
#   RESUME_LLM_BASE_URL=https://api.cerebras.ai/v1
#   RESUME_DESIGN_MODELS=zai-glm-4.7,gpt-oss-120b
#   RESUME_CONTENT_MODEL=zai-glm-4.7

# Email notifications via Gmail SMTP (use a Gmail App Password, not your login password)
EMAIL_USER=
EMAIL_PASS=

# ── FILE STORAGE (mentor resources, resume PDFs, profile avatars) ────────────
# Driver selects where uploaded files live. Swapping to your college server
# later is just STORAGE_DRIVER=local (no code changes).
#   local → files saved under server/uploads, served at /uploads (default)
#   s3    → Amazon S3 (or any S3-compatible endpoint, e.g. MinIO)
# Full provisioning runbooks (AWS S3 + MinIO): see docs/STORAGE.md
STORAGE_DRIVER=local
# Absolute public base URL of THIS server (used to build file URLs for the
# 'local' driver). Set to your deployed origin in production.
SERVER_PUBLIC_URL=http://localhost:5000

# Required only when STORAGE_DRIVER=s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: CDN/custom public base URL for files (e.g. CloudFront).
S3_PUBLIC_BASE_URL=
# Optional: custom S3-compatible endpoint (MinIO / college object store).
S3_ENDPOINT=

# ── LIVE VIDEO (self-hosted LiveKit SFU) ─────────────────────────────────────
# Powers 1:1 mentorship, technical-interview, and group-discussion video, plus
# 1-to-many webinars. Run the SFU with deploy/docker-compose.livekit.yml — full
# setup (ports, TURN, TLS) in docs/LIVEKIT.md. When any of these are unset the
# /api/rtc/token endpoint returns 503 and live video is disabled.
#   WS URL the browser connects to (ws:// for local, wss:// behind TLS in prod)
LIVEKIT_WS_URL=ws://localhost:7880
#   API key/secret pair — MUST match the keys block in deploy/livekit.yaml
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── OPTIONAL: GD AI Panelist (real human-voice moderator) ────────────────────
# A separate, portable LiveKit Agents worker (see ../voice-agent/) can join GD
# rooms as a real conversational HR/technical panelist. It needs NO new server
# env — it reuses the LiveKit keys above and has its own ../voice-agent/.env.
# When it is not deployed, the GD falls back to the built-in browser-TTS moderator
# (graceful degradation). See voice-agent/README.md.
